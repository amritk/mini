{
  "extends": ["./tsconfig.json", "../../tsconfig.build.json"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Re-asserted because the shared `../../tsconfig.build.json` is applied last
    // in `extends` and resets both back to the Node-only defaults, which would
    // take the DOM away from the one package whose whole subject it is.
    "lib": ["ESNext", "DOM"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
