{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The DOM host is the only file allowed to know what a browser is, so it
    // gets its own pass with the DOM library available. Keeping it on a separate
    // config is what lets the main pass stay DOM-free and actually mean
    // something.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/hosts/create-dom-host.ts",
    "src/hosts/create-dom-host.test.tsx",
    "src/hosts/dom-environment.ts",
    "src/hosts/dom-reset.ts",
    "src/hosts/dom-reset.test.ts",
    "src/router/create-browser-history.ts",
    "src/router/create-browser-history.test.ts",
    "src/hosts/dom-environment.test.ts",
    "src/parity.test.tsx",
    "src/vocabulary-coverage.test.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
