{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The DOM library is deliberately absent. The runtime is supposed to be free
    // of any platform dependency, and leaving `lib.dom` out turns that from a
    // convention into something the compiler enforces: a stray `document` or
    // `HTMLElement` anywhere in the core fails the check rather than quietly
    // working in a browser and breaking on a device. Node's ambient types go for
    // the same reason.
    //
    // The DOM host is the one place that genuinely needs those types, so it is
    // excluded here and checked by `tsconfig.dom.json` instead.
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-native",
    // Resolve the package's own JSX runtime to source during type checking. The
    // JSX transform emits `import { jsx } from '@amritk/mini-native/jsx-runtime'`,
    // which would otherwise resolve to `dist` (via the package exports) and fail
    // before the package has been built.
    "paths": {
      "@amritk/mini-native/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@amritk/mini-native/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "@amritk/mini-native": ["./src/index.ts"]
    },
    // Resolve `@amritk/mini-helpers` to the workspace's SOURCE through the
    // `development` condition it already declares, rather than to its `dist`.
    // CI type-checks BEFORE it builds, so without this a fresh clone would look
    // for a `.d.ts` that does not exist yet. It also means the shared sources
    // are checked against THIS package's platform-free `lib`, so a browser
    // global smuggled into them fails here and not only on a device.
    // Undone in `tsconfig.build.json`, where the emit must resolve to `dist`.
    "customConditions": ["development"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": [
    "dist",
    "node_modules",
    "examples/js-framework-benchmark/bootstrap.ts",
    "src/hosts/create-dom-host.ts",
    "src/hosts/create-dom-host.test.tsx",
    "src/hosts/dom-environment.ts",
    "src/hosts/dom-reset.ts",
    "src/hosts/dom-reset.test.ts",
    "src/router/create-browser-history.ts",
    "src/router/create-browser-history.test.ts",
    "src/router/route-stack.dom.test.tsx",
    "src/hosts/dom-environment.test.ts",
    "src/parity.test.tsx",
    "src/vocabulary-coverage.test.tsx"
  ]
}
