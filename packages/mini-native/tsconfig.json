{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The DOM library is deliberately absent, and now there is no exception to
    // it. The runtime targets Lynx, whose main-thread context is not a browser
    // and does not pretend to be: there is no `document`, no `window` and no
    // `HTMLElement`. Leaving `lib.dom` out turns that from a convention into
    // something the compiler enforces, so a stray platform reference fails the
    // check here rather than at runtime on a device. Node's ambient types are
    // absent for the same reason.
    //
    // This used to carry a second pass (`tsconfig.dom.json`) for the DOM host.
    // The DOM host is gone, and with it the only file in the package that was
    // allowed to know what a browser is.
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-native",
    // Resolve the package's own JSX runtime to source during type checking. The
    // JSX transform emits `import { jsx } from '@amritk/mini-native/jsx-runtime'`,
    // which would otherwise resolve to `dist` (via the package exports) and fail
    // before the package has been built.
    "paths": {
      "@amritk/mini-native/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@amritk/mini-native/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "@amritk/mini-native": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["dist", "node_modules", "examples/js-framework-benchmark/bootstrap.ts"]
}
