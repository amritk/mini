{
  "extends": ["./tsconfig.json", "../../tsconfig.build.json"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // No DOM library, and no exception to it. Lynx's main-thread context is not
    // a browser, so a build that compiled against browser types would accept
    // code that cannot run on the target — see `tsconfig.json`. `lib` and
    // `types` are re-asserted because the shared `../../tsconfig.build.json`
    // (applied last in `extends`) resets them to the Node-only defaults.
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-lynx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // `src/router/browser` is built by `tsconfig.dom.build.json` instead, which is
  // the only pass that compiles against the DOM library. Excluded here so this
  // one keeps failing on a platform reference the way it always has.
  "exclude": ["dist", "node_modules", "src/router/browser", "**/*.test.ts", "**/*.test.tsx"]
}
