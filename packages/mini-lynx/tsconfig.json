{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The DOM library is deliberately absent, and now there is no exception to
    // it. The runtime targets Lynx, whose main-thread context is not a browser
    // and does not pretend to be: there is no `document`, no `window` and no
    // `HTMLElement`. Leaving `lib.dom` out turns that from a convention into
    // something the compiler enforces, so a stray platform reference fails the
    // check here rather than at runtime on a device. Node's ambient types are
    // absent for the same reason.
    //
    // The one exemption is `src/router/browser/`, excluded below and checked by
    // `tsconfig.dom.json` instead. It is a `RouterHistory` for an app rendering
    // on the web, it is one module wide, and it is on its own export subpath —
    // so the exemption is a directory the compiler enforces rather than a
    // convention. Nothing else in the package may name `window`.
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-lynx",
    // Resolve the package's own JSX runtime to source during type checking. The
    // JSX transform emits `import { jsx } from '@amritk/mini-lynx/jsx-runtime'`,
    // which would otherwise resolve to `dist` (via the package exports) and fail
    // before the package has been built.
    "paths": {
      "@amritk/mini-lynx/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@amritk/mini-lynx/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "@amritk/mini-lynx": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["dist", "node_modules", "src/router/browser", "examples/js-framework-benchmark/bootstrap.ts"]
}
