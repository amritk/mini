{
  "name": "@amritk/mini-helpers",
  "version": "0.0.0",
  "description": "The pure helpers @amritk/mini and @amritk/mini-lynx both need: no reactivity, no platform, no dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "amritk",
  "sideEffects": false,
  "keywords": [
    "routing",
    "json-schema",
    "validation",
    "typescript",
    "mjst"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/mini.git",
    "directory": "packages/mini-helpers"
  },
  "homepage": "https://github.com/amritk/mini/tree/main/packages/mini-helpers#readme",
  "bugs": {
    "url": "https://github.com/amritk/mini/issues"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "AI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f && node ../../scripts/strip-comments.mjs",
    "types:check": "tsgo -p . --noEmit",
    "test": "NODE_ENV=production vitest run --root ../.. packages/mini-helpers/"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "peerDependencies": {
    "@amritk/runtime-validators": ">=0.8.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@amritk/runtime-validators": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amritk/runtime-validators": "^0.9.0",
    "typescript": "^5"
  }
}
