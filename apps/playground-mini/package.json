{
  "name": "@amritk/playground-mini",
  "version": "0.0.1",
  "private": true,
  "description": "Kitchen-sink playground for @amritk/mini, deployed to Cloudflare Workers as a static SPA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types:check": "tsgo -p . --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@amritk/mini": "workspace:*",
    "@amritk/runtime-validators": "^0.9.0",
    "@tanstack/query-core": "^5.101.2"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^8",
    "wrangler": "^4"
  }
}
