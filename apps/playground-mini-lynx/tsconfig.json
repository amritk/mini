{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The app gets the DOM libs; the package it consumes deliberately does not,
    // because Lynx's main-thread context is not a browser. An APP previewing in
    // one is allowed to know that — it supplies the engine, and calling
    // `createDomPapi()` in `src/main.tsx` is that decision made explicitly and
    // in exactly one place.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-lynx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
