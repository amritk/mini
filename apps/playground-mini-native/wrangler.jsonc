{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playground-mini-native",
  "compatibility_date": "2026-07-01",
  // An assets-only Worker: no `main`, so Cloudflare serves `dist/` from its
  // edge cache without invoking a Worker at all. `single-page-application`
  // rewrites unknown paths to `index.html`, which is what lets
  // `createBrowserHistory` run in `history` mode and makes `/gestures` a real
  // URL you can reload and share.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
